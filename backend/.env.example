# ── AI Configuration ──
# Paste your key in backend/.env (this file is gitignored)

# Option A: OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini

# Option B: OpenRouter (many models, pay-as-you-go) — https://openrouter.ai/keys
# OPENAI_API_KEY=sk-or-v1-your-key
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=openai/gpt-4o-mini
# AI_PROVIDER=openrouter

# Other compatible providers (Groq, Together, etc.) — set OPENAI_BASE_URL to their endpoint

APP_URL=http://localhost:3001
# ── Messaging channels (comma-separated: telegram, whatsapp) ──
# RECOMMENDED: Use Telegram while CallMeBot WhatsApp is full
NOTIFY_CHANNELS=telegram

# ── Telegram (FREE — works immediately, recommended) ──
# 1. Open Telegram, search @BotFather
# 2. Send /newbot and follow steps → copy the bot token
# 3. Search for your new bot and send it any message (e.g. "hi")
# 4. Visit: https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
# 5. Find "chat":{"id":123456789} — that number is your TELEGRAM_CHAT_ID
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=123456789

# ── WhatsApp via CallMeBot (free but often full — try new bot number) ──
# NEW bot number (2025+): +34 644 81 58 78  (old +34 644 51 95 23 may say "Bot is full")
# 1. Add +34 644 81 58 78 to contacts as "CallMeBot"
# 2. WhatsApp message to it: "I allow callmebot to send me messages"
# 3. Copy API key from reply (or try again in 24h if full)
# WHATSAPP_ENABLED=true
# WHATSAPP_PROVIDER=callmebot
# WHATSAPP_PHONE=254712345678
# CALLMEBOT_API_KEY=your-api-key

# Daily digest hour (24h, server local time)
TELEGRAM_DAILY_DIGEST=true
TELEGRAM_DIGEST_HOUR=8

# ── WhatsApp via Twilio (paid, always works) ──
# WHATSAPP_PROVIDER=twilio
# WHATSAPP_ENABLED=true
# WHATSAPP_PHONE=whatsapp:+254712345678
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Optional: n8n webhook URL
# N8N_WEBHOOK_URL=

# ── Supabase (cloud database + file storage) ──
# When SUPABASE_DATABASE_URL is set, app uses Supabase Postgres instead of local study.db
# Use SUPABASE_DATABASE_URL on Render (not DATABASE_URL — Render may override that if a Postgres DB is linked)
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Use the project base URL only — NOT .../rest/v1 or .../storage/v1
# SUPABASE_SERVICE_ROLE_KEY=your-secret-key (sb_secret_... or legacy service_role JWT)
#
# Ireland / West EU = aws-0-eu-west-1.pooler.supabase.com
# Get from Supabase → Settings → Database → Connection string → URI → Transaction (port 6543)
# SUPABASE_DATABASE_URL=postgresql://postgres.ohcyihfzpvdqpdmpwlsy:YOUR_DB_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
#
# NOT the anon/service API key — use the database password (reset under Settings → Database).
# URL-encode special chars in password (@ → %40, # → %23, ! → %21).
#
# Migrate local data once:  npm run migrate:supabase
# Test connection:          npm run test:db
# Health check (running):   GET /api/health/db
